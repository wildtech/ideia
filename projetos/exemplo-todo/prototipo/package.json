{
  "name": "exemplo-todo-prototipo",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo de uma lista de tarefas com duas etapas (React + Vite + SQLite). Dados fictícios.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=jornadas",
    "demo": "npm run narracao && playwright test --project=demo && tsx scripts/montar-video.ts",
    "capturas": "playwright test --project=capturas",
    "verificar": "node ../../../tools/verificar.js .",
    "verificar:rede": "node ../../../tools/verificar.js . --rede",
    "narracao": "tsx scripts/narrar.ts",
    "dividir": "tsx scripts/dividir-voz.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
